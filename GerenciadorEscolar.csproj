<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <!-- Troque para net6.0-windows | net7.0-windows | net8.0-windows -->
    <TargetFramework>net8.0-windows</TargetFramework>

    <!-- Necessário para WinForms -->
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Mesmo OutputType do antigo -->
    <OutputType>WinExe</OutputType>

    <!-- Igual ao antigo -->
    <RootNamespace>GerenciadorDeTurmas</RootNamespace>
    <AssemblyName>GerenciadorDeTurmas</AssemblyName>

    <!-- Você usava .NET Framework 4.7.2. 
         Se depender de APIs antigas, ative isso: -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- Para permitir AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

  </PropertyGroup>

  <ItemGroup>
    <!-- Suas dependências via NuGet entram aqui automaticamente
         após usar "dotnet add package" ou o gerenciador do VS -->
    <PackageReference Include="MySql.Data" Version="9.0.0" />
    <PackageReference Include="Google.Protobuf" Version="3.26.1" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.3.1" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />

    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="K4os.Hash.xxHash" Version="1.0.8" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.0" />
  </ItemGroup>

</Project>
